  "query": "\n            UPDATE devices\n            SET\n                name = COALESCE($3, name),\n                description = COALESCE($4, description),\n                is_active = COALESCE($5, is_active)\n            WHERE id = $1 AND owner_id = $2\n            RETURNING id, name, description, owner_id, registered_at, is_active\n            ",
